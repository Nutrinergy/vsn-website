---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Arcs from './Arcs.astro';
import type { Crumb } from '../lib/schema';
interface Props {
  crumbs: Crumb[];
  kicker?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { crumbs, kicker, title, lead, image, imageAlt = '', imagePosition = 'center' } = Astro.props;
---
<section class:list={['page-hero', { 'has-image': image }]}>
  <div class="wrap grid">
    <div class="text">
      <Breadcrumbs items={crumbs} />
      {kicker && <p class="label">{kicker}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image ? (
      <div class="media">
        <Image src={image} alt={imageAlt} widths={[480, 720, 960, 1200]} sizes="(min-width: 60rem) 42vw, 92vw" loading="eager" fetchpriority="high" class="img-cover" style={`object-position:${imagePosition}`} />
        <Arcs class="hero-arcs" width={30} />
      </div>
    ) : (
      <Arcs class="hero-arcs hero-arcs--solo" width={28} />
    )}
  </div>
</section>
<style>
  .page-hero { position: relative; padding-block: var(--space-l) var(--space-l); overflow: clip; }
  .grid { display: grid; gap: var(--space-l); align-items: center; position: relative; }
  .text { display: grid; gap: var(--space-s); align-content: start; position: relative; z-index: 1; }
  .text h1 { margin-top: var(--space-xs); font-size: clamp(2.4rem, 1.3rem + 4.4vw, 5rem); }
  .text .lead { max-width: 40ch; }
  .media { position: relative; aspect-ratio: 5 / 4; border-radius: var(--radius-lg); }
  .media :global(img) { border-radius: var(--radius-lg); }
  .media :global(.hero-arcs) { position: absolute; width: 38%; right: -6%; bottom: -14%; }
  :global(.hero-arcs--solo) { position: absolute; right: -2rem; top: -3rem; width: clamp(160px, 26vw, 380px); opacity: 1; }
  @media (min-width: 60rem) {
    .has-image .grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
    .page-hero:not(.has-image) .text { max-width: 60rem; padding-right: 22vw; }
  }
  @media (max-width: 59.99rem) {
    :global(.hero-arcs--solo) { width: 150px; top: -1rem; right: -3rem; opacity: 0.5; }
  }
</style>
