---
import type { CollectionEntry } from 'astro:content';
import { KENNISBANK_CATEGORIES } from '../consts';
import ArticleCard from './ArticleCard.astro';
interface Props { posts: CollectionEntry<'kennisbank'>[]; active?: string; counts: Record<string, number>; total: number }
const { posts, active, counts, total } = Astro.props;
---
<nav class="chips" aria-label="Categorieën">
  <a href="/kennisbank/" aria-current={!active ? 'page' : undefined}>Alles <span>{total}</span></a>
  {Object.entries(KENNISBANK_CATEGORIES).map(([k, c]) => (
    <a href={`/kennisbank/${k}/`} aria-current={active === k ? 'page' : undefined}>{c.label} <span>{counts[k] ?? 0}</span></a>
  ))}
</nav>
<div class="cards">
  {posts.map((p, i) => <div data-reveal style={`--d:${i % 3}`}><ArticleCard post={p} headingLevel="h2" eager={i < 3} /></div>)}
</div>
<style>
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--space-l); }
  .chips a { display: inline-flex; gap: 0.5rem; align-items: center; padding: 0.55rem 1.05rem; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); text-decoration: none; font-weight: 650; font-size: 0.95rem; transition: background-color 0.2s var(--ease-out); }
  .chips a span { font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chips a:hover { background: var(--paper-2); }
  .chips a[aria-current='page'] { background: var(--ink); color: var(--paper); box-shadow: none; }
  .chips a[aria-current='page'] span { color: var(--teal); }
  .cards { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
</style>
