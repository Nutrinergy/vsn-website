---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arcs from '../components/Arcs.astro';
import TwoDoors from '../components/TwoDoors.astro';
import { breadcrumbs, webPage, ORG_ID } from '../lib/schema';
import people from '../data/sportdietisten.json';
import hero from '../assets/foto/studiedag-zaal.jpg';
import foto2 from '../assets/foto/studiedag-presentatie.jpg';
import annemarijke from '../assets/bestuur/anne-marijke-ambergen.jpg';
import marja from '../assets/bestuur/marja-ockeloen.jpg';
import esther from '../assets/bestuur/esther-holvast.jpg';
import dirk from '../assets/bestuur/dirk-verbraak.jpg';

const title = 'Over de VSN: dé beroepsvereniging voor sportvoedingsexperts';
const description = 'De Vereniging Sportvoedingsexperts Nederland (VSN) verenigt sinds 2004 sportdiëtisten en sportvoedingsexperts. Lees wie we zijn en wie het bestuur vormt.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Over ons', href: '/over-ons/' }];
const bestuur = [
  { n: 'Anne-Marijke Ambergen', r: 'Voorzitter', img: annemarijke },
  { n: 'Marja Ockeloen-van der Hulst', r: 'Bestuurslid', img: marja },
  { n: 'Esther Holvast-van der Ven', r: 'Bestuurslid', img: esther },
  { n: 'Dirk Verbraak', r: 'Bestuurslid', img: dirk },
];
const werkgroepen = [
  { t: 'Website', d: 'Onderhoudt de teksten en kennis op deze website.' },
  { t: 'Scholing', d: 'Zorgt voor sterke sprekers tijdens de ALV, masterclass en studiedag.' },
  { t: 'Social media', d: 'Deelt regelmatig berichten op onze kanalen.' },
  { t: 'Plantaardige voeding', d: 'Ontwikkelt praktische tools voor leden.' },
];
const aboutLd = { '@type': 'AboutPage', url: 'https://sportdietetiek.nl/over-ons/', name: title, about: { '@id': ORG_ID }, mainEntity: { '@id': ORG_ID } };
---
<Base {title} {description} schema={[webPage({ path: '/over-ons/', title, description, type: 'AboutPage' }), breadcrumbs(crumbs), aboutLd]}>
  <PageHero {crumbs} kicker="Sinds 2004" title="Wetenschap en praktijk, verbonden" lead="De Vereniging Sportvoedingsexperts Nederland (VSN) is dé beroepsvereniging voor sportdiëtisten en andere sportvoedingsexperts die wetenschap en praktijk met elkaar verbinden." image={hero} imageAlt="Leden van de VSN luisteren naar een spreker tijdens de studiedag" />

  <section class="section section--tight">
    <div class="wrap story">
      <div class="prose" data-reveal>
        <p class="big">In 2004 richtten pioniers <strong>Anja van Geel, Geertje Becker en Joris Hermans</strong> de vereniging op. Sindsdien zetten wij ons in om sportvoedingsexperts in Nederland te verenigen, te versterken en zichtbaar te maken.</p>
        <p>Onze leden zijn hoogopgeleide professionals met een specialisatie in sportvoeding, werkzaam in alle lagen van de Nederlandse sport. Van amateurclubs tot topsportprogramma’s, van jeugdige talenten tot revalidatiepatiënten: onze leden maken dagelijks het verschil. Sinds kort verwelkomen we ook leden met een universitaire achtergrond in voeding, aangevuld met een IOC-diploma of een master in Sports Nutrition of vergelijkbare opleiding.</p>
        <p>Wij geloven dat elke sporter, ongeacht niveau, toegang verdient tot betrouwbare, wetenschappelijk onderbouwde voedingsinformatie. In een tijd waarin sporters van alle kanten adviezen krijgen, zorgen wij ervoor dat zij altijd terecht kunnen bij échte experts: onze leden.</p>
      </div>
      <aside class="values" data-reveal style="--d:1">
        <Arcs class="v-arcs" tone="light" animate={false} width={30} />
        <p class="label">Waar wij voor staan</p>
        <ul role="list">
          <li>Onafhankelijkheid</li>
          <li>Professionaliteit</li>
          <li>Kwaliteit</li>
        </ul>
        <p class="v-n"><strong>{people.length}</strong> leden op de kaart, verspreid over heel Nederland.</p>
      </aside>
    </div>
  </section>

  <section class="section section--paper2" aria-labelledby="doel">
    <div class="wrap">
      <div class="section-head" data-reveal><p class="label">Ons doel</p><h2 id="doel">Elke sportvoedingsexpert op zijn of haar niveau bijscholen, kennis delen, de kwaliteit bewaken en sportvoeding op de kaart zetten.</h2></div>
      <div class="offer">
        <div class="o" data-reveal><h3>Een professioneel netwerk</h3><p>Hét netwerk van sportdiëtisten met een afgeronde post-HBO Sportdiëtetiek en sportvoedingsexperts met een universitaire voedingsachtergrond plus IOC-diploma of master Sports Nutrition. Voor individuen, teams, bonden en zorgprofessionals.</p></div>
        <div class="o" data-reveal style="--d:1"><h3>Kennisdeling en verdieping</h3><p>De jaarlijkse ALV, masterclass en studiedag met inspirerende sprekers en actuele thema’s. Zo blijf je op de hoogte van de nieuwste wetenschappelijke inzichten.</p></div>
        <div class="o" data-reveal style="--d:2"><h3>Een podium voor jouw expertise</h3><p>We maken jouw expertise zichtbaar bij sporters, teams en collega-professionals. Via de kaart op deze website vinden sporters je eenvoudig.</p></div>
        <div class="o" data-reveal style="--d:3"><h3>Kwaliteitsborging via SCAS</h3><p>Met SCAS-registratie (voor sportdiëtisten) toon je aan dat je kennis, vaardigheden en houding aantoonbaar op niveau zijn en regelmatig worden getoetst.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="bestuur-t">
    <div class="wrap">
      <div class="section-head section-head--split" data-reveal>
        <div><p class="label">Het bestuur</p><h2 id="bestuur-t">De mensen achter de VSN</h2></div>
        <p class="lead">Het bestuur komt regelmatig bij elkaar over de website, accreditatie, de ALV, studiedagen en masterclasses.</p>
      </div>
      <ul class="board" role="list">
        {bestuur.map((b, i) => (
          <li data-reveal style={`--d:${i}`}>
            <Image src={b.img} alt={`Portret van ${b.n}`} width={480} height={560} widths={[240, 360, 480]} sizes="(min-width: 64rem) 20vw, 45vw" class="img-cover" />
            <p><strong>{b.n}</strong><span>{b.r}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="leden-t">
    <div class="wrap members">
      <div class="m-img" data-reveal><Image src={foto2} alt="Spreker tijdens de VSN studiedag 2025" widths={[480, 800]} sizes="(min-width: 60rem) 40vw, 92vw" class="img-cover" /></div>
      <div class="m-txt">
        <p class="label" data-reveal>Een vereniging vóór en dóór leden</p>
        <h2 id="leden-t" data-reveal>Wat we van onze leden vragen</h2>
        <p data-reveal>Bij de VSN sta je er niet alleen voor, maar we vragen wel een actieve bijdrage. Sluit je aan bij een van onze werkgroepen:</p>
        <ul class="wg" role="list">
          {werkgroepen.map((w, i) => <li data-reveal style={`--d:${i}`}><strong>{w.t}</strong><span>{w.d}</span></li>)}
        </ul>
        <p data-reveal>Ieder VSN-lid dat sportdiëtist is, raden we aan om SCAS-geregistreerd te zijn. Het register laat je kwaliteit zien op het gebied van werkervaring, bij- en nascholing en deskundigheidsbevordering.</p>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="worden">
    <div class="wrap--narrow prose" data-reveal>
      <h2 id="worden">Sportvoedingsexpert worden</h2>
      <p>Sportdiëtist word je door na de opleiding Voeding en Diëtetiek een post-HBO opleiding Sportdiëtetiek te volgen. Erkende post-HBO opleidingen Voeding en Sport vind je bij de <a href="https://www.hva.nl/" rel="noopener" target="_blank">HvA</a> en de <a href="https://www.han.nl/" rel="noopener" target="_blank">HAN</a>. Als diëtist of met een universitaire achtergrond in voeding kun je ook het IOC-diploma in Sports Nutrition of een master in Sports and Nutrition volgen.</p>
    </div>
  </section>
  <TwoDoors />
</Base>
<style>
  .story { display: grid; gap: var(--space-xl); align-items: start; }
  @media (min-width: 60rem) { .story { grid-template-columns: 1.3fr 0.7fr; } }
  .big { font-size: var(--step-1); line-height: 1.5; color: var(--ink); }
  .values { position: relative; overflow: hidden; display: grid; gap: var(--space-s); padding: var(--space-l); border-radius: var(--radius-lg); background: var(--ink); color: oklch(0.86 0.02 200); }
  .values :global(.v-arcs) { position: absolute; width: 170px; right: -50px; top: -50px; }
  .values .label { color: var(--teal); position: relative; }
  .values ul { list-style: none; padding: 0; position: relative; }
  .values li { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); font-weight: 850; font-stretch: 122%; letter-spacing: -0.02em; color: var(--paper); line-height: 1.15; }
  .values li:nth-child(2) { color: var(--teal); }
  .values li:nth-child(3) { color: var(--orange); }
  .v-n { font-size: 0.95rem; position: relative; }
  .v-n strong { color: var(--paper); }
  .section-head h2 { font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.6rem); }
  .offer { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .o { display: grid; gap: 0.5rem; align-content: start; padding-top: var(--space-s); border-top: 3px solid var(--teal); }
  .o:nth-child(2n) { border-top-color: var(--orange); }
  .o h3 { font-size: 1.3rem; }
  .o p { color: var(--ink-2); font-size: 1rem; }
  .board { list-style: none; padding: 0; display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .board li { display: grid; gap: 0.75rem; }
  .board :global(img) { aspect-ratio: 6 / 7; border-radius: var(--radius-lg); filter: saturate(0.9); transition: filter 0.4s var(--ease-out); }
  .board li:hover :global(img) { filter: saturate(1.05); }
  .board p { display: grid; line-height: 1.3; }
  .board strong { font-size: 1.1rem; font-stretch: 106%; }
  .board span { color: var(--muted); font-size: 0.95rem; }
  .members { display: grid; gap: var(--space-xl); align-items: center; }
  @media (min-width: 60rem) { .members { grid-template-columns: 0.9fr 1.1fr; } }
  .m-img { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; }
  .m-txt { display: grid; gap: var(--space-s); }
  .wg { list-style: none; padding: 0; display: grid; gap: 0; margin-block: var(--space-xs); }
  .wg li { display: grid; gap: 0.15rem; padding-block: 0.85rem; border-top: 1px solid oklch(0.975 0.008 85 / 0.16); }
  .wg strong { color: var(--paper); font-stretch: 108%; }
  .wg span { font-size: 0.975rem; }
</style>
