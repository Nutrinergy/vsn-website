---
import Logo from './Logo.astro';
import { NAV, MEMBER_LOGIN } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Vereniging Sportvoedingsexperts Nederland, naar de homepage">
      <Logo />
    </a>

    <nav class="nav" aria-label="Hoofdmenu">
      <ul class="nav-list" role="list">
        {NAV.map((item, i) => (
          <li class:list={['nav-item', { 'has-sub': item.children }]}>
            {item.children ? (
              <>
                <button
                  class:list={['nav-link', 'nav-toggle', { active: isActive(item.href) }]}
                  aria-expanded="false"
                  aria-controls={`sub-${i}`}
                  data-sub-toggle
                >
                  {item.label}
                  <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="sub" id={`sub-${i}`}>
                  <ul role="list">
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} aria-current={path === c.href ? 'page' : undefined}>
                          <span>{c.label}</span>
                          {c.note && <small>{c.note}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="login" href={MEMBER_LOGIN} rel="nofollow">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="6.5" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 17.5c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>Inloggen</span>
      </a>
      <a class="btn btn--small cta" href="/zoek-een-sport-dietist-in-de-buurt/">
        Vind een sportdiëtist
      </a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden data-mobile>
    <nav class="wrap mobile-inner" aria-label="Mobiel menu">
      <a class="btn mobile-cta" href="/zoek-een-sport-dietist-in-de-buurt/">Vind een sportdiëtist <span class="arrow" aria-hidden="true">→</span></a>
      <ul role="list" class="mobile-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class="m-main">{item.label}</a>
            {item.children && (
              <ul role="list" class="m-sub">
                {item.children.filter((c) => c.href !== item.href).map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="m-login" href={MEMBER_LOGIN} rel="nofollow">Inloggen voor leden →</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const toggles = header.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]');
    const closeAll = (except?: HTMLButtonElement) =>
      toggles.forEach((t) => t !== except && t.setAttribute('aria-expanded', 'false'));
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        closeAll(btn);
        btn.setAttribute('aria-expanded', String(!open));
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.has-sub')) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const open = header.querySelector<HTMLButtonElement>('[data-sub-toggle][aria-expanded="true"]');
        closeAll();
        open?.focus();
        if (menuBtn?.getAttribute('aria-expanded') === 'true') setMenu(false);
      }
    });

    const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobile = header.querySelector<HTMLElement>('[data-mobile]');
    const setMenu = (open: boolean) => {
      menuBtn?.setAttribute('aria-expanded', String(open));
      if (mobile) mobile.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
      if (!open) menuBtn?.focus();
    };
    menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    transition: box-shadow 0.3s var(--ease-out);
  }
  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--line), 0 10px 30px -22px oklch(0.24 0.035 205 / 0.5);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4.75rem;
  }
  .brand {
    flex: none;
    width: clamp(150px, 12vw + 60px, 196px);
    display: block;
  }
  .nav {
    display: none;
    margin-inline: auto;
  }
  .nav-list {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.8rem;
    border: 0;
    background: none;
    border-radius: var(--radius-pill);
    font-size: 0.975rem;
    font-weight: 600;
    font-stretch: 104%;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.18s var(--ease-out);
  }
  .nav-link:hover,
  .nav-toggle[aria-expanded='true'] {
    background: var(--paper-2);
    color: var(--ink);
  }
  .nav-link.active {
    box-shadow: inset 0 -2px 0 var(--orange);
    border-radius: 0;
  }
  .chev {
    width: 0.75rem;
    transition: transform 0.25s var(--ease-out);
  }
  .nav-toggle[aria-expanded='true'] .chev {
    transform: rotate(180deg);
  }
  .sub {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.5rem;
    min-width: 17rem;
    padding: 0.5rem;
    background: oklch(0.99 0.004 85);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--line);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s var(--ease-out), transform 0.25s var(--ease-out), visibility 0s linear 0.2s;
  }
  .nav-toggle[aria-expanded='true'] + .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.2s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .sub ul {
    list-style: none;
    padding: 0;
  }
  .sub a {
    display: grid;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-s);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    line-height: 1.3;
  }
  .sub a small {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .sub a:hover,
  .sub a[aria-current='page'] {
    background: var(--teal-tint);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }
  .login {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-2);
    text-decoration: none;
  }
  .login svg {
    width: 1.15rem;
  }
  .login:hover {
    color: var(--ink);
  }
  .cta {
    display: none;
  }
  .menu-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 0;
    background: var(--ink);
    color: var(--paper);
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .burger i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] .burger i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .burger i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .mobile {
    position: fixed;
    inset: 4.75rem 0 0;
    background: var(--ink);
    color: var(--paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-inner {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-xl);
  }
  .mobile-cta {
    justify-self: start;
  }
  .mobile-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }
  .m-main {
    font-size: 1.9rem;
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.015em;
    color: var(--paper);
    text-decoration: none;
    line-height: 1.1;
  }
  .m-sub {
    list-style: none;
    padding: 0.6rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .m-sub a {
    color: var(--teal-tint);
    font-weight: 500;
    text-decoration: none;
  }
  .m-login {
    color: var(--orange);
    font-weight: 700;
    text-decoration: none;
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
  @media (min-width: 40rem) {
    .cta {
      display: inline-flex;
    }
  }
  @media (min-width: 72rem) {
    .nav {
      display: block;
    }
    .menu-btn,
    .mobile {
      display: none !important;
    }
    .login {
      display: inline-flex;
    }
  }
</style>
