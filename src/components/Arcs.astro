---
/**
 * Het merkmotief: de twee bogen uit het VSN-beeldmerk, ingezet als baanlijnen.
 * Geometrie: teal-boog rond (64,72), oranje boog is dezelfde boog 180° gedraaid rond het midden.
 */
interface Props {
  class?: string;
  animate?: boolean;
  width?: number;
  tone?: 'brand' | 'light' | 'ink';
  style?: string;
}
const { class: cls = '', animate = true, width = 33, tone = 'brand', style } = Astro.props;
const colors = {
  brand: ['var(--teal)', 'var(--orange)'],
  light: ['oklch(0.975 0.008 85 / 0.16)', 'var(--orange)'],
  ink: ['var(--teal-deep)', 'var(--orange)'],
}[tone];
---
<svg class:list={['arcs', cls, { 'arcs--animate': animate }]} viewBox="-20 -20 176 224" aria-hidden="true" focusable="false" style={style}>
  <path class="arc arc--a" d="M100.8 41.1 A48 48 0 1 0 36.5 111.3" stroke={colors[0]} stroke-width={width} pathLength="1" />
  <path class="arc arc--b" d="M35.2 142.9 A48 48 0 1 0 99.5 72.7" stroke={colors[1]} stroke-width={width} pathLength="1" />
</svg>
<style>
  .arcs { overflow: visible; pointer-events: none; }
  .arc { fill: none; stroke-linecap: round; }
  @media (prefers-reduced-motion: no-preference) {
    .arcs--animate .arc { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s var(--ease-out) forwards; }
    .arcs--animate .arc--b { animation-delay: 0.25s; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
