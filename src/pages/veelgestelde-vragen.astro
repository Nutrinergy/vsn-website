---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TwoDoors from '../components/TwoDoors.astro';
import { breadcrumbs, webPage, faq } from '../lib/schema';
import { FAQ_SPORTERS, FAQ_VERENIGING } from '../data/faq';

const title = 'Veelgestelde vragen over sportdiëtisten en de VSN';
const description = 'Wat doet een sportdiëtist, wat is het verschil met een diëtist en welke supplementen zijn zinvol? Antwoorden op veelgestelde vragen over sportvoeding en de VSN.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Veelgestelde vragen', href: '/veelgestelde-vragen/' }];
const groups = [
  { id: 'sporters', t: 'Voor sporters', items: FAQ_SPORTERS },
  { id: 'vereniging', t: 'Over de vereniging', items: FAQ_VERENIGING },
];
---
<Base {title} {description} schema={[webPage({ path: '/veelgestelde-vragen/', title, description, type: 'FAQPage' }), breadcrumbs(crumbs), faq([...FAQ_SPORTERS, ...FAQ_VERENIGING])]}>
  <PageHero {crumbs} kicker="FAQ" title="Veelgestelde vragen" lead="Heb je een vraag over sportdiëtisten of over de Vereniging Sportvoedingsexperts Nederland? Grote kans dat het antwoord hieronder staat." />
  <section class="section section--tight">
    <div class="wrap layout">
      <nav class="jump" aria-label="Categorieën">
        <ul role="list">{groups.map((g) => <li><a href={`#${g.id}`}>{g.t}</a></li>)}</ul>
      </nav>
      <div class="groups">
        {groups.map((g) => (
          <section aria-labelledby={g.id}>
            <h2 id={g.id} class="h3">{g.t}</h2>
            <div class="faq">{g.items.map((x, i) => <details open={i === 0}><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
          </section>
        ))}
        <p class="more">Staat je vraag er niet bij? <a href="/contact/">Neem contact met ons op</a>, of <a href="/zoek-een-sport-dietist-in-de-buurt/">vraag het direct aan een sportdiëtist</a> bij jou in de buurt.</p>
      </div>
    </div>
  </section>
  <TwoDoors />
</Base>
<style>
  .layout { display: grid; gap: var(--space-l); }
  @media (min-width: 60rem) { .layout { grid-template-columns: 14rem minmax(0, 1fr); gap: var(--space-xl); } .jump { position: sticky; top: 6.5rem; align-self: start; } }
  .jump ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  @media (min-width: 60rem) { .jump ul { display: grid; } }
  .jump a { display: inline-block; padding: 0.5rem 1rem; border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); text-decoration: none; font-weight: 650; }
  .jump a:hover { background: var(--ink); color: var(--paper); }
  .groups { display: grid; gap: var(--space-xl); max-width: 50rem; }
  .more { padding: var(--space-m); border-radius: var(--radius-m); background: var(--teal-tint); }
</style>
