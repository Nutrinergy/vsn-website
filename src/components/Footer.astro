---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Arcs from './Arcs.astro';
import { SOCIAL, PARTNERS, MEMBER_LOGIN, SITE } from '../consts';
import mysportscience from '../assets/partners/mysportscience-logo.png';
import medicas from '../assets/partners/medicas-logo.png';
import topsport from '../assets/partners/Topsport-Topics-300px.png';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <Arcs class="footer-arcs" tone="light" animate={false} width={30} />
  <div class="wrap top">
    <div class="intro">
      <a href="/" class="f-logo" aria-label="VSN, naar de homepage"><Logo variant="dark" /></a>
      <p>{SITE.tagline}. Sinds 2004 de beroepsvereniging voor sportdiëtisten en sportvoedingsexperts in Nederland.</p>
      <ul class="social" role="list">
        <li>
          <a href={SOCIAL.instagram} rel="noopener" target="_blank" aria-label="VSN op Instagram (opent in nieuw venster)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg>
          </a>
        </li>
        <li>
          <a href={SOCIAL.x} rel="noopener" target="_blank" aria-label="VSN op X (opent in nieuw venster)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <nav class="cols" aria-label="Footer">
      <div>
        <h2 class="f-head">Voor sporters</h2>
        <ul role="list">
          <li><a href="/zoek-een-sport-dietist-in-de-buurt/">Vind een sportdiëtist</a></li>
          <li><a href="/sportdietist/">Wat doet een sportdiëtist?</a></li>
          <li><a href="/sportvoedingspiramide/">Sportvoedingspiramide</a></li>
          <li><a href="/voeding-en-sport/">Voeding en sport</a></li>
          <li><a href="/kennisbank/">Kennisbank</a></li>
          <li><a href="/voeding-en-sport/recepten/">Recepten</a></li>
        </ul>
      </div>
      <div>
        <h2 class="f-head">Voor professionals</h2>
        <ul role="list">
          <li><a href="/lid-worden/">Lid worden</a></li>
          <li><a href="/agenda/">Agenda en scholing</a></li>
          <li><a href={MEMBER_LOGIN} rel="nofollow">Inloggen ledenportaal</a></li>
          <li><a href={PARTNERS.scas} rel="noopener" target="_blank">SCAS-register</a></li>
        </ul>
      </div>
      <div>
        <h2 class="f-head">Vereniging</h2>
        <ul role="list">
          <li><a href="/over-ons/">Over ons</a></li>
          <li><a href="/veelgestelde-vragen/">Veelgestelde vragen</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacyverklaring/">Privacyverklaring</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap partners">
    <h2 class="f-head">Voordelen en partners</h2>
    <ul role="list" class="p-list">
      <li>
        <a href={PARTNERS.mysportscience} rel="noopener" target="_blank">
          <span class="p-logo"><Image src={mysportscience} alt="Mysportscience Academy" width={140} /></span>
          <span>Scholing van wetenschap naar praktijk. Leden krijgen <strong>30% korting</strong>.</span>
        </a>
      </li>
      <li>
        <a href={PARTNERS.topsportTopics} rel="noopener" target="_blank">
          <span class="p-logo"><Image src={topsport} alt="Topsport Topics" width={140} /></span>
          <span>Factsheets, literatuursamenvattingen en congresverslagen.</span>
        </a>
      </li>
      <li>
        <a href={PARTNERS.medicas} rel="noopener" target="_blank">
          <span class="p-logo"><Image src={medicas} alt="Medicas" width={120} /></span>
          <span>De VSN gebruikt de incassodiensten van Medicas.</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="wrap bottom">
    <p>© {year} Vereniging Sportvoedingsexperts Nederland · KvK {SITE.kvk} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <p><a href="/privacyverklaring/">Privacy</a> · <a href="/sitemap-index.xml">Sitemap</a></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: oklch(0.86 0.02 200);
    padding-top: var(--space-xl);
    font-size: 1rem;
  }
  .site-footer :global(.footer-arcs) {
    position: absolute;
    right: -6rem;
    top: -4rem;
    width: clamp(240px, 32vw, 460px);
    opacity: 0.9;
  }
  .top {
    position: relative;
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 60rem) {
    .top {
      grid-template-columns: 1fr 1.6fr;
    }
  }
  .intro {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    max-width: 26rem;
  }
  .f-logo {
    width: 210px;
  }
  .social {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--paper);
    box-shadow: inset 0 0 0 1.5px oklch(0.975 0.008 85 / 0.3);
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .social a:hover {
    background: var(--orange);
    color: var(--ink);
  }
  .social svg {
    width: 1.2rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-l);
  }
  .f-head {
    font-size: 0.8rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 0.9rem;
  }
  .cols ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .site-footer a {
    color: var(--paper);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--orange);
  }
  .partners {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid oklch(0.975 0.008 85 / 0.14);
  }
  .p-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .p-list a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    font-size: 0.925rem;
    line-height: 1.45;
    color: oklch(0.86 0.02 200);
  }
  .p-list a:hover {
    color: var(--paper);
  }
  .p-logo {
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 4rem;
    padding: 0.6rem;
    border-radius: var(--radius-s);
    background: var(--paper);
  }
  .p-logo :global(img) {
    max-height: 2.8rem;
    width: auto;
    object-fit: contain;
  }
  .bottom a {
    text-decoration: underline;
    text-decoration-color: oklch(0.975 0.008 85 / 0.4);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--space-l);
    padding-block: var(--space-m);
    border-top: 1px solid oklch(0.975 0.008 85 / 0.14);
    font-size: 0.875rem;
    color: oklch(0.78 0.02 200);
  }
</style>
